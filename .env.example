# Copy to .env for local overrides. Never commit .env. No real secrets belong here.
# Defaults shown are what applies when a variable is unset or empty.
# Comments sit on their own lines: some env loaders keep trailing text in the value.

# --- API (src/config.ts) ---
# development | test | production
NODE_ENV=development
# API listen port
PORT=8080
# SQLite file (:memory: for throwaway)
DB_PATH=data/platform.db
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# strict: a contract violation becomes a 500; log: logged and sent
RESPONSE_VALIDATION=strict
# Mounts the dev token issuer; refused when NODE_ENV=production
DEV_ISSUER=false
# Token issuer URL (default follows PORT)
ISSUER_URL=http://127.0.0.1:8080/dev
# Expected token audience
AUDIENCE=support-platform-api
# Base URL for all three upstreams
MOCKS_URL=http://127.0.0.1:8081
# Per-upstream overrides of MOCKS_URL (empty: use MOCKS_URL)
CASES_URL=
ENTITLEMENT_URL=
WAREHOUSE_URL=
# Requests per minute, per client and per agent
RATE_LIMIT_CLIENT_PER_MINUTE=100
RATE_LIMIT_AGENT_PER_MINUTE=30
# Total time for one request's upstream calls, retries included (ms).
# Keep it below the timeout of whatever sits in front (gateway, agent tool call).
REQUEST_BUDGET_MS=10000
# How often the entitlement CSV export and XML feed are polled (seconds)
ENTITLEMENT_REFRESH_SECONDS=900

# On shutdown, how long /readyz reports 503 before the listener closes (ms).
# Set it to the load balancer's probe interval in production; 0 locally.
SHUTDOWN_READINESS_DELAY_MS=0

# --- Mock upstreams (mocks/server.ts) ---
# Mocks listen port
MOCK_PORT=8081
# Seed for generated fixture data
MOCK_SEED=42
# Fault injection as JSON, e.g. {"warehouse":{"down":true}} (empty: none)
MOCK_FAULTS=

# --- Shared ---
# Fixture clock anchor (unset: system time). make run sets this to the value below.
NOW=2026-11-06T12:00:00Z
