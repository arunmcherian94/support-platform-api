# Copy to .env for local overrides. Never commit .env. No real secrets belong here.
# Defaults shown are what applies when a variable is unset or empty.
# Comments sit on their own lines: some env loaders keep trailing text in the value.

# --- API (src/config.ts) ---
# development | test | production
NODE_ENV=development
# API listen port
PORT=8080
# SQLite file (:memory: for throwaway)
DB_PATH=data/platform.db
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# strict: a contract violation becomes a 500; log: logged and sent
RESPONSE_VALIDATION=strict
# Mounts the dev token issuer; refused when NODE_ENV=production
DEV_ISSUER=false
# Token issuer URL (default follows PORT)
ISSUER_URL=http://127.0.0.1:8080/dev
# Base URL for links this API sends out (the case.escalated webhook's caseUrl).
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Expected token audience
AUDIENCE=support-platform-api
# Base URL for all three upstreams
MOCKS_URL=http://127.0.0.1:8081
# Per-upstream overrides of MOCKS_URL (empty: use MOCKS_URL)
CASES_URL=
ENTITLEMENT_URL=
WAREHOUSE_URL=
# Requests per minute, per client and per agent
RATE_LIMIT_CLIENT_PER_MINUTE=100
RATE_LIMIT_AGENT_PER_MINUTE=30
# Total time for one request's upstream calls, retries included (ms).
# Keep it below the timeout of whatever sits in front (gateway, agent tool call).
REQUEST_BUDGET_MS=10000
# How often the entitlement CSV export and XML feed are polled (seconds)
ENTITLEMENT_REFRESH_SECONDS=900
# case.escalated webhook receiver (empty: no subscription, nothing is sent)
WEBHOOK_URL=
# Standard Webhooks secret for WEBHOOK_URL: whsec_ + base64. Dev-only example value.
WEBHOOK_SECRET=whsec_ZGV2LW9ubHktd2ViaG9vay1zZWNyZXQtZm9yLWxvY2Fs
# How often pending webhook deliveries are checked (ms)
WEBHOOK_DISPATCH_INTERVAL_MS=1000

# On shutdown, how long /readyz reports 503 before the listener closes (ms).
# Set it to the load balancer's probe interval in production; 0 locally.
SHUTDOWN_READINESS_DELAY_MS=0

# --- Mock upstreams (mocks/server.ts) ---
# Mocks listen port
MOCK_PORT=8081
# Fault injection as JSON, e.g. {"warehouse":{"down":true}} (empty: none)
MOCK_FAULTS=

# --- Shared ---
# Fixture clock anchor (unset: system time). make run sets this to the value below.
NOW=2026-11-06T12:00:00Z

# --- MCP server (make mcp) and approval command (make approve) ---
# The signed-in user's access token the agent acts for (dev shortcut: one user per process).
# Required by make mcp; get one from the dev issuer (see README).
USER_TOKEN=
# The API the MCP server and the approval command call
API_URL=http://127.0.0.1:8080
# Token endpoint for the exchange and the approver's token (default: API_URL/dev/oauth/token)
TOKEN_URL=
# The agent client that exchanges USER_TOKEN; dev-only public values from config/dev-clients.json
AGENT_CLIENT_ID=support-copilot
AGENT_CLIENT_SECRET=dev-only-support-copilot-secret
# The human approver's client (dev: the support console, user jdoe)
APPROVER_CLIENT_ID=support-console
APPROVER_CLIENT_SECRET=dev-only-support-console-secret

# --- Agent demo (make demo-live only; paid). Export in your shell; never commit a real key. ---
OPENAI_API_KEY=
# Default: gpt-6-luna (cheapest current model with function calling)
OPENAI_MODEL=
